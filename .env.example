# ============================================================
# Sao chép file này thành .env rồi điền giá trị thực.
# File .env KHÔNG được commit lên git.
# ============================================================

# ===== Google reCAPTCHA =====
# Đăng ký key tại https://www.google.com/recaptcha/admin/create
#
# Chọn loại:
#   - reCAPTCHA v2 "I'm not a robot" Checkbox  → checkbox hiện ra cho user tick
#   - reCAPTCHA v3                              → invisible, trả về điểm 0.0–1.0
#
# Backend hỗ trợ cả hai, không cần sửa code.

CAPTCHA_ENABLED=true
CAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
CAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Chỉ dùng cho v3: từ chối nếu score thấp hơn ngưỡng này
CAPTCHA_MIN_SCORE=0.5

# Tắt captcha khi dev local (không cần key thật)
# CAPTCHA_ENABLED=false
