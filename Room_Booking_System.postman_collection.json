{
	"info": {
		"name": "Room Booking System API",
		"description": "Collection kiểm thử toàn diện các API của Room Booking System (Java 21, Spring Boot 4.x)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8086",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "refreshToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Get Captcha Challenge",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/auth/captcha",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "captcha"]
						}
					}
				},
				{
					"name": "Register First Admin",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Password123@\",\n  \"email\": \"admin@roombooking.com\",\n  \"fullName\": \"System Administrator\",\n  \"phoneNumber\": \"0987654321\",\n  \"department\": \"IT\",\n  \"captchaId\": \"REPLACE_WITH_CHALLENGE_ID\",\n  \"captchaAnswer\": \"REPLACE_WITH_ANSWER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/admin/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "admin", "register"]
						}
					}
				},
				{
					"name": "Login (Admin / User)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"usernameOrEmail\": \"admin\",\n  \"password\": \"Password123@\",\n  \"captchaId\": \"REPLACE_WITH_CHALLENGE_ID\",\n  \"captchaAnswer\": \"REPLACE_WITH_ANSWER\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					}
				},
				{
					"name": "Refresh Access Token",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/refresh-token",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "refresh-token"]
						}
					}
				}
			]
		},
		{
			"name": "2. Rooms",
			"item": [
				{
					"name": "Get All Rooms",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/rooms?page=0&size=10",
							"host": ["{{baseUrl}}"],
							"path": ["api", "rooms"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" }
							]
						}
					}
				},
				{
					"name": "Create Room (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"code\": \"R101\",\n  \"name\": \"Phòng Hội Thảo Mặt Trời\",\n  \"type\": \"ROOM\",\n  \"capacity\": 20,\n  \"location\": \"Tầng 3 - Tòa A\",\n  \"amenities\": \"Máy chiếu, Micro, Điều hòa\",\n  \"description\": \"Phòng hội thảo tiêu chuẩn\",\n  \"active\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/rooms",
							"host": ["{{baseUrl}}"],
							"path": ["api", "rooms"]
						}
					}
				}
			]
		},
		{
			"name": "3. Bookings",
			"item": [
				{
					"name": "Create Booking",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"roomId\": 1,\n  \"title\": \"Họp Đánh Giá Dự Án\",\n  \"purpose\": \"Báo cáo tiến độ quý 4\",\n  \"attendees\": 10,\n  \"startTime\": \"2026-11-15T09:00:00\",\n  \"endTime\": \"2026-11-15T11:00:00\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/bookings",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings"]
						}
					}
				},
				{
					"name": "My Bookings",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/bookings/my-bookings",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "my-bookings"]
						}
					}
				},
				{
					"name": "Approve Booking (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/bookings/1/approve",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "1", "approve"]
						}
					}
				},
				{
					"name": "Get Booking Schedule (Timeline)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/bookings/schedule?from=2026-11-01&to=2026-11-30",
							"host": ["{{baseUrl}}"],
							"path": ["api", "bookings", "schedule"],
							"query": [
								{ "key": "from", "value": "2026-11-01" },
								{ "key": "to", "value": "2026-11-30" }
							]
						}
					}
				}
			]
		},
		{
			"name": "4. Dashboard",
			"item": [
				{
					"name": "Admin Dashboard Stats",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/dashboard/admin",
							"host": ["{{baseUrl}}"],
							"path": ["api", "dashboard", "admin"]
						}
					}
				},
				{
					"name": "User Dashboard Stats",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/dashboard/user",
							"host": ["{{baseUrl}}"],
							"path": ["api", "dashboard", "user"]
						}
					}
				}
			]
		}
	]
}
